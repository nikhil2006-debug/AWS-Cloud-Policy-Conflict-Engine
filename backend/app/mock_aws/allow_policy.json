{
  "PolicyName": "AllowS3Read",
  "Arn": "arn:aws:iam::123456789012:policy/AllowS3Read",
  "Document": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AllowS3Read",
        "Effect": "Allow",
        "Action": ["s3:GetObject"],
        "Resource": "arn:aws:s3:::demo-bucket/*"
      }
    ]
  }
}